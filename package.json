{
  "name": "agentleisure-guard",
  "version": "0.7.0",
  "description": "Hard limits for AI agent tools: human approval for destructive actions, secret blocking, loop breaker, budget cap and a tamper-evident journal. Zero dependencies, zero install scripts.",
  "type": "module",
  "main": "./index.mjs",
  "types": "./index.d.ts",
  "bin": {
    "agentleisure-guard": "./cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    },
    "./mcp": {
      "types": "./mcp-guard.d.ts",
      "default": "./mcp-guard.mjs"
    },
    "./policy": {
      "default": "./policy.mjs"
    }
  },
  "files": [
    "index.mjs",
    "index.d.ts",
    "agent-guard.mjs",
    "mcp-guard.mjs",
    "mcp-guard.d.ts",
    "snapshots.mjs",
    "policy.mjs",
    "cli.mjs",
    "replay.mjs",
    "replay-incidents.mjs",
    "blast.mjs",
    "blast-fixes.mjs",
    "hook.mjs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "ai",
    "agent",
    "llm",
    "safety",
    "guardrails",
    "human-in-the-loop",
    "approval",
    "mcp",
    "langchain",
    "tools",
    "mcp-gateway",
    "prompt-injection"
  ],
  "homepage": "https://agentleisure.com/console",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HsEarth/agentleisure-guard.git"
  },
  "bugs": {
    "url": "https://github.com/HsEarth/agentleisure-guard/issues"
  },
  "license": "MIT",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  }
}
